#!/usr/bin/env bash

# Configuration
# ------------------------------------------------------------------
# Mapping friendly aliases to upstream targets
# (Using a function instead of associative array for macOS/Bash 3.2 compatibility)
get_board_target() {
    case "$1" in
        "oemga_alpha") echo "bl54l15u_dvk/nrf54l15/cpuapp" ;;
        *) echo "" ;;
    esac
}

# Docker Configuration
DOCKER_IMG="${OEMGA_DOCKER_IMAGE:-ghcr.io/nrfconnect/sdk-nrf-toolchain:latest}"

# Helper Functions
# ------------------------------------------------------------------
print_usage() {
    echo "OEMGA Build Wrapper"
    echo "Usage:"
    echo "  ./oemga setup               Initialize/Update the West workspace"
    echo "  ./oemga build <alias> [app] Build an app for a board alias"
    echo "  ./oemga clean               Clean the build directory"
    echo "  ./oemga shell               Open a bash shell inside the Docker container"
    echo ""
    echo "Available Aliases:"
    echo "  - oemga_alpha"
}

run_in_docker() {
    # Determine mount points
    if [[ "$(basename $(pwd))" == "oemga-core" ]]; then
        MOUNT_DIR=$(dirname $(pwd))
        WORKDIR_PATH="/workdir/oemga-core"
    else
        MOUNT_DIR=$(pwd)
        WORKDIR_PATH="/workdir"
    fi

    echo "🐳 Running in Docker ($DOCKER_IMG)..."
    
    # FIX APPLIED:
    # 1. Removed ACCEPT_JLINK_LICENSE=1 to prevent the udev/installation crash.
    # 2. Added --entrypoint /bin/bash to bypass the image's default startup script 
    #    (which forces the check).
    # 3. Used '/bin/bash -l -c' to ensure a login shell loads the toolchain ENV vars.
    
    docker run --rm -it \
        --privileged \
        --entrypoint /bin/bash \
        -v "$MOUNT_DIR":/workdir \
        -v /dev:/dev \
        -w "$WORKDIR_PATH" \
        "$DOCKER_IMG" \
        -l -c "$1"
}

# Command Parsing
# ------------------------------------------------------------------
COMMAND=$1
ARG2=$2
ARG3=$3

if [ -z "$COMMAND" ]; then
    print_usage
    exit 1
fi

case $COMMAND in
    setup)
        echo "⚙️  Step 1: Checking SDK Workspace..."
        
        if [ -d ".west" ] || [ -d "../.west" ]; then
            echo "✅ Workspace already initialized. Skipping 'west init'."
            run_in_docker "west zephyr-export"
        else
            echo "🚀 No workspace found. Initializing (Inside Docker)..."
            run_in_docker "west init -l . && west update && west zephyr-export"
        fi

        echo "🐍 Step 2: Creating Virtual Env (Host Side)..."
        # Using a hidden name to avoid conflict with the script name 'oemga'
        if [ ! -d ".venv_oemga" ]; then
            python3 -m venv .venv_oemga || { echo "❌ Failed to create venv. Try 'chmod +w .' first."; exit 1; }
            
            echo "📦 Step 3: Installing Flashing Tools..."
            ./.venv_oemga/bin/pip install west
        else
            echo "✅ '.venv_oemga' already exists."
        fi

        echo "✨ Setup truly complete this time!"
        ;;

    build)
        ALIAS=$ARG2
        APP_PATH=${ARG3:-apps/hello_oemga} 

        if [ -z "$ALIAS" ]; then
            echo "❌ Error: Missing board alias."
            print_usage
            exit 1
        fi

        TARGET=$(get_board_target "$ALIAS")

        if [ -z "$TARGET" ]; then
            echo "❌ Error: Unknown alias '$ALIAS'."
            print_usage
            exit 1
        fi

        echo "🔨 Building '$APP_PATH' for '$ALIAS' (Target: $TARGET)"
        
        run_in_docker "west build -p auto -b $TARGET $APP_PATH"
        ;;
    
    flash)
        echo "⚡ Searching for compiled firmware..."
        HEX_FILE=$(find build -name "merged.hex" | head -n 1)

        if [ -z "$HEX_FILE" ]; then
            echo "❌ Error: Could not find merged.hex."
            exit 1
        fi

        echo "✅ Found: $HEX_FILE"

        # Step 1: Explicitly wipe the nRF54
        echo "🧹 Erasing Chip..."
        nrfutil device erase --all

        # Step 2: Program using the simple, stable syntax
        # We use --options chip_erase_mode=ERASE_NONE because we already erased
        echo "🚀 Flashing Firmware..."
        if nrfutil device program --firmware "$HEX_FILE" --options chip_erase_mode=ERASE_NONE; then
            echo "✨ SUCCESS! Resetting board..."
            nrfutil device reset --reset-kind=RESET_PIN
        else
            echo "❌ ERROR: nrfutil failed."
            echo "   Try running 'nrfutil device list' to confirm your Mac sees the board."
            exit 1
        fi
        ;;
    
    clean)
        echo "🧹 Cleaning build artifacts..."
        rm -rf build
        ;;

    shell)
        run_in_docker "/bin/bash"
        ;;

    create)
        NEW_APP_NAME=$ARG2
        NEW_APP_PATH="apps/$NEW_APP_NAME"

        if [ -z "$NEW_APP_NAME" ]; then
            echo "❌ Error: Please provide a name for the new project."
            echo "   Usage: ./oemga create my_new_sensor"
            exit 1
        fi

        echo "🚀 Creating new project: $NEW_APP_PATH"
        mkdir -p "$NEW_APP_PATH/src"

        # Create CMakeLists.txt
        cat <<EOF > "$NEW_APP_PATH/CMakeLists.txt"
cmake_minimum_required(VERSION 3.20)
find_package(Zephyr REQUIRED HINTS \$ENV{ZEPHYR_BASE})
project($NEW_APP_NAME)
target_sources(app PRIVATE src/main.c)
EOF

        # Create prj.conf
        cat <<EOF > "$NEW_APP_PATH/prj.conf"
CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
# Potential for nRF54: CONFIG_BT=y (if you need BLE later)
EOF

        # Create main.c
        cat <<EOF > "$NEW_APP_PATH/src/main.c"
#include <zephyr/kernel.h>
#include <zephyr/sys/printk.h>

int main(void) {
    printk("OeMga Project '$NEW_APP_NAME' started!\n");
    while (1) {
        k_sleep(K_MSEC(2000));
        printk("Heartbeat from $NEW_APP_NAME\n");
    }
    return 0;
}
EOF
        echo "✅ Done! You can now build it with:"
        echo "   ./oemga build oemga_alpha $NEW_APP_PATH"
        ;;

    *)
        echo "❌ Unknown command: $COMMAND"
        print_usage
        exit 1
        ;;
esac