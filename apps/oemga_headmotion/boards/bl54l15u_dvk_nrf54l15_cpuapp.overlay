/*
 * OEMGA ALPHA BOARD OVERLAY
 * Target: bl54l15u_dvk_nrf54l15_cpuapp
 * * This file applies hardware changes specific to the OEMGA prototype
 * on top of the standard bl54l15u_dvk definition.
 */
&i2c21 {
    status = "okay";
    pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
    pinctrl-names = "default", "sleep";
    mysensor: mysensor@6a{
        compatible = "i2c-device";
        status = "okay";
        reg = < 0x6A >;
    };
};

&pinctrl {
	/omit-if-no-ref/ i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 11)>,
				    <NRF_PSEL(TWIM_SDA, 1, 12)>;
		};
	};
    /omit-if-no-ref/ i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 11)>,
				    <NRF_PSEL(TWIM_SDA, 1, 12)>;
		};
	};
};

/ {
    aliases {
        /* This allows us to call the led "my-led" in C code */
        my-led = &test_led;
    };

    leds {
        compatible = "gpio-leds";
        test_led: led_0 {
            /* Port 2, Pin 0 */
            gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>; 
            label = "Debug LED";
        };
    };
};

/ {
    zephyr,user {
        /* Changed names to end in -gpios for compatibility */
        ad8233-fr-gpios   = <&gpio2 6 GPIO_ACTIVE_HIGH>;
        ad8233-sdn-gpios  = <&gpio2 2 GPIO_ACTIVE_HIGH>;
        ad8233-acdc-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
        ad8233-lod-gpios  = <&gpio1 2 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
    };
};

&adc {
    status = "okay";
};